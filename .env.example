# Local development (`npm run dev`). Production values are Cloudflare secrets/vars — see README.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: email notification for new inquiries via Resend
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=
