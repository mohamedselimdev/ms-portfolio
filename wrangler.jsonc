{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference service binding required by OpenNext; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "portfolio" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ms-portfolio-db",
      // Replace with the id printed by: npx wrangler d1 create ms-portfolio-db
      "database_id": "39572a3f-2fc3-4650-9061-b770b7ef804a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // CMS uploads. Create with: npx wrangler r2 bucket create ms-portfolio-media
    { "binding": "MEDIA", "bucket_name": "ms-portfolio-media" }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
